# Production settings for docker compose. On the server: cp .env.production.example .env, then fill in.
# Never commit the real .env.

# --- Django -------------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Host names the API answers to (comma-separated). "*" accepts any; tighten to the domain later.
DJANGO_ALLOWED_HOSTS=*
DJANGO_LOG_LEVEL=INFO
# Swagger/Redoc at /api/docs/
API_DOCS_ENABLED=False

# The Next.js frontend's origin(s)
CORS_ALLOWED_ORIGINS=
# true: any origin may call the API (ignores CORS_ALLOWED_ORIGINS). Fine to start with; tighten later.
CORS_ALLOW_ALL_ORIGINS=true
# Full https:// origins, no wildcards (only the admin login form needs this).
CSRF_TRUSTED_ORIGINS=https://junction26.optinnos.com

# --- Database (compose builds DATABASE_URL from these) ------------------------------------------------
POSTGRES_DB=warmline
POSTGRES_USER=warmline
# URL-safe only: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- HTTPS ----------------------------------------------------------------------------------------------
# Only for `docker compose --profile https`: Caddy gets a certificate for this domain.
DOMAIN=junction26.optinnos.com
# Host port for the API (bound to 127.0.0.1) when you use your own reverse proxy
WEB_PORT=8000

# --- Gunicorn -------------------------------------------------------------------------------------------
# Workers x threads = concurrent requests. 2 x 4 suits a 1-2 vCPU server.
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180

# --- Auth -----------------------------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Integrations ---------------------------------------------------------------------------------------
CALA_API_BASE_URL=https://api.cala.ai
CALA_API_KEY=
GEMINI_API_KEY=
DECK_CHECK_LLM_PROVIDER=gemini
DECK_CHECK_LLM_MODEL=
# MARKET_LLM_MODEL=
ANTHROPIC_API_KEY=

# --- Deck checks and alerts ---------------------------------------------------------------------------
DECK_CHECK_MAX_UPLOAD_MB=20
DECK_CHECK_REUSE_HOURS=24
ALERT_BACKFILL_DAYS=60
ALERT_SCAN_TIME=02:00
ALERT_SCAN_TIMEZONE=Europe/Helsinki
# The scheduler service runs the nightly scan; keep it out of the web workers.
ALERT_SCHEDULER_IN_PROCESS=false
