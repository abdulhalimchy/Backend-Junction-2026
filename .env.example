# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# SQLite for now. For PostgreSQL later:
# DATABASE_URL=postgres://warmline:password@localhost:5432/warmline
DATABASE_URL=sqlite:///db.sqlite3

# Next.js frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Swagger/Redoc at /api/docs/ (defaults to on in development, off in production)
# API_DOCS_ENABLED=True

# Max pitch-deck upload size in MB
DECK_CHECK_MAX_UPLOAD_MB=20

# Cala knowledge graph (server only). Create one at https://console.cala.ai/api-keys
CALA_API_BASE_URL=https://api.cala.ai
CALA_API_KEY=
# Shared secret for the frontend server's Cala gateway calls (X-Gateway-Key). Same value as CALA_GATEWAY_KEY
# in the frontend's .env.local. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
CALA_GATEWAY_KEY=
# Google sign-in: OAuth web client ID (Google Cloud console > APIs & Services > Credentials). Same value as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
# Alert scan: rounds dated within this many days count as news (also on an entity's first scan).
ALERT_BACKFILL_DAYS=60
# Nightly alert scan (local time). In production run `manage.py run_alert_scheduler` or cron `scan_alerts --nightly`.
ALERT_SCAN_TIME=02:00
ALERT_SCAN_TIMEZONE=Europe/Helsinki
# ALERT_SCHEDULER_IN_PROCESS=true   # default true in development: the scheduler runs inside runserver
# ALERT_SCAN_ON_WATCH=true          # check a newly watched entity right away

# LLM for deck checks (server only): "gemini" (default) or "anthropic".
DECK_CHECK_LLM_PROVIDER=gemini
# Exact model id from https://aistudio.google.com (empty = provider default)
DECK_CHECK_LLM_MODEL=
# Gemini key (deck checks and market analysis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model for market analysis (guard and report summary); defaults to gemini-4-hydrogen
# MARKET_LLM_MODEL=
# Only if DECK_CHECK_LLM_PROVIDER=anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hours a re-check of the same PDF keeps its earlier verdicts while the record is unchanged (0: always judge again).
DECK_CHECK_REUSE_HOURS=24
